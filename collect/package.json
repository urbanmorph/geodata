{
  "name": "collect",
  "private": true,
  "type": "module",
  "description": "collect.bharatlas.com — crowd map-capture, publishes to the bharatlas catalogue",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.functions.json",
