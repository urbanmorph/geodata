exports[`golden answers (a changed answer needs its ANSWER_V bumped) > counts > counts@v1 1`] = `
{
  "body": {
    "data": {
      "counts": {
        "S1": 3,
        "S2": 3,
      },
      "group_by": "state",
      "layer_id": "dist",
      "total": 6,
    },
  },
  "status": 200,
}
`;

