{
  "name": "bharatlas-mcp",
  "version": "1.7.0",
  "description": "MCP server for India's open geo data. Query layers, locate points, find nearby features, filter and group data. Also authors collect maps: register a share link, moderate contributions, and submit them to bharatlas as a layer.",
  "keywords": ["mcp", "india", "geo", "geospatial", "gis", "boundaries", "parquet", "pmtiles", "llm", "claude", "bharatlas", "collect"],
  "repository": { "type": "git", "url": "git+https://github.com/urbanmorph/geodata.git", "directory": "mcp" },
  "homepage": "https://bharatlas.com/mcp",
  "mcpName": "io.github.sathya-sankaran/bharatlas-mcp",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test collect-links.test.js import-records.test.js read-tools.test.js version.test.js",
    "test:live": "node test.js"
  },
  "bin": {
    "bharatlas-mcp": "index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "license": "MIT"
}
